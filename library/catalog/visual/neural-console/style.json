{
  "id": "neural-console",
  "name": "Neural Console",
  "kind": "visual",
  "version": 1,
  "status": "built-in",
  "summary": "A vertical sci-fi control screen: a rounded, feathered console on deep navy-black, a glowing cyan ring hub with a magenta second ring, dashed network paths, scrolling mono logs, a glass status card with meters, scanlines.",
  "tags": ["sci-fi", "dark", "cyan", "magenta", "console", "hud", "glow", "tech", "maximal"],
  "suits": ["AI and tech explainers", "system-online intros", "data and stat reveals", "cyber hooks", "science facts told as a machine reading"],
  "needs": { "footage": false, "3d": false },
  "frame": { "width": 1080, "height": 1920 },
  "palette": [
    { "role": "background", "hex": "#03050d", "use": "the void outside and at the edge of the console field" },
    { "role": "surface", "hex": "#09111f", "use": "the console field's centre (radial to the void), glass card fill at 60%" },
    { "role": "text", "hex": "#eafcff", "use": "headlines and status titles (paper)" },
    { "role": "muted", "hex": "#d2f1f7", "use": "small labels and log lines, always at 48%" },
    { "role": "faint", "hex": "#087c9c", "use": "core deep: the 74 px grid (at 18%), the meter gradient's start, idle ring segments" },
    { "role": "accent", "hex": "#00e5ff", "use": "core cyan: rings, labels, network paths, meters; means short (blue) waves in this catalog's samples" },
    { "role": "accentHot", "hex": "#c6faff", "use": "core hot: dust motes, the metric, node fills, the hub's core label" },
    { "role": "accent2", "hex": "#ff2bd6", "use": "secondary magenta: the second ring, log emphasis, the meter's other end; means long (red) waves in the samples" },
    { "role": "accent2Hot", "hex": "#ffc4f3", "use": "secondary hot: magenta nodes" },
    { "role": "orb", "hex": "#6c43ff", "use": "one blurred depth orb at 4.5% only; never a fill, line or text" }
  ],
  "fonts": {
    "display": { "family": "Arimo", "source": "google", "weights": [400, 700], "prefer": "Arial" },
    "body": { "family": "Arimo", "source": "google", "weights": [400, 700], "prefer": "Arial" },
    "mono": { "family": "Inconsolata", "source": "google", "weights": [400, 600], "prefer": "Consolas" }
