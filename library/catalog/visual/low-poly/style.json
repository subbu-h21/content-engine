    "display": 104,
    "title": 104,
    "number": 300,
    "body": 54,
    "label": 40,
    "sub": 46,
    "min": 32,
    "leading": 1.2,
    "tracking": 0.2,
    "numberTracking": 0.02,
    "subTracking": 0.04,
    "case": "titles in capitals; subtitles in sentence case; the sub-line in lower case",
    "emphasis": "on titles, the emphasised word in the time of day's icon colour; in subtitles, none",
    "shadowBlur": 14,
    "shadowAlpha": 0.55,
    "maxWords": 8
  },
  "layout": { "margin": 96, "safe": { "top": 230, "bottom": 330 }, "align": "center", "skyBand": 600, "subtitleY": 1330 },
