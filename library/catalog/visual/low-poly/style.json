    "unit": 60,
    "tile": { "r": 1, "gap": 0.015, "cap": 0.16, "jitter": 0.04 },
    "heights": { "sand": 0.4, "grass": 0.82, "hill": 1.25, "rock": 1.95 },
    "light": { "ambient": 0.76, "diffuse": 0.38, "haze": 0.1 },
    "surf": { "scale": 1.12, "alpha": 0.32 },
    "water": { "cell": 84, "amp": 7, "haze": 0.55 },
    "ribbon": { "width": 34, "halo": 2.4, "haloAlpha": 0.32, "tilt": 7 },
    "icon": 34,
    "stars": 70
  },
  "motion": {
    "recipes": {
      "rise": { "kind": "ease", "curve": [0.33, 1, 0.68, 1], "duration": 0.5, "freq": 13, "decay": 7, "amp": 0.18 },
      "drop": { "kind": "ease", "curve": [0.32, 0, 0.67, 0], "duration": 0.22, "distance": 2.4, "bounce": 0.22 },
      "pop": { "kind": "spring", "damping": 18, "stiffness": 370, "mass": 1 },
      "letter": { "kind": "ease", "curve": [0.33, 1, 0.68, 1], "duration": 0.5, "stagger": 0.055, "freq": 13, "decay": 7, "amp": 0.18 },
      "subtitle": { "kind": "ease", "curve": [0.33, 1, 0.68, 1], "duration": 0.35 },
      "fly": { "kind": "ease", "curve": [0.33, 1, 0.68, 1], "duration": 1.2 },
      "beam": { "kind": "ease", "curve": [0.65, 0, 0.35, 1], "duration": 0.6 },
      "turn": { "kind": "ease", "curve": [0.65, 0, 0.35, 1], "duration": 5 }
    },
    "enter": "rise",
    "exit": "cut",
    "slot": 0.156,
    "stagger": 0.156,
    "hold": 1.8
  },
  "finish": { "grain": 0, "vignette": 0, "glow": false, "bloom": 0.22, "bloomNight": 0.5, "edgeBlur": 3 },
  "banned": [
    "outlines or black: shadows and facet shading are the only darks",
    "textures, photos or smooth (rounded) shading: every face is one flat colour",
    "perspective: the projection never changes (orthographic, azimuth 45°)",
    "cubes of cubes or pixel textures (that's a voxel game)",
    "grain, dissolves or perspective whip-pans",
    "two pieces arriving in the same time slot",
    "movers heading at the lens",
    "copying any existing game's grids, buildings, characters, UI or type",
    "saturated or neon colour: pastel, low contrast, a handful of hues"
  ],
