{
  "id": "low-poly",
  "name": "Low-poly",
  "kind": "visual",
  "version": 1,
  "status": "built-in",
  "summary": "A tiny faceted pastel island under an orthographic isometric camera: flat-shaded hex columns, box houses, cone pines and icosphere props drawn as SVG polygons, faceted water, time of day as colour keyframes, and every piece arriving with a bounce.",
  "tags": ["calm", "pastel", "isometric", "low-poly", "faceted", "3d look", "world building"],
  "suits": ["calm explainers", "something grows", "world and place stories", "day-cycle pieces", "game-like trailers"],
  "needs": { "footage": false, "3d": false },
  "frame": { "width": 1080, "height": 1920 },
