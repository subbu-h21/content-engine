{
  "id": "night-sky-classroom",
  "name": "Night-sky Classroom",
  "kind": "visual",
  "version": 1,
  "status": "built-in",
  "summary": "Friendly kids' science: a night-blue ground, round Fredoka headlines with bold emphasis, glowing colourful light diagrams, and a ground that turns into the day sky at the payoff.",
  "tags": ["friendly", "kids", "dark", "night", "colourful", "glow", "rounded", "explainer"],
  "suits": ["kids' science", "classroom explainer", "light and colour", "nature facts"],
  "needs": { "footage": false, "3d": false },
  "frame": { "width": 1080, "height": 1920 },
  "palette": [
    { "role": "background", "hex": "#0b1026", "use": "the night ground of every frame; pill fills are this colour at 66%" },
    { "role": "surface", "hex": "#18224a", "use": "the soft radial lift (ground glow) behind the main object" },
    { "role": "text", "hex": "#f4ecdc", "use": "every headline and label: the only text colour; also the air molecules" },
    { "role": "muted", "hex": "#8a90a8", "use": "eyebrows, chapter markers, pill borders, dashed guides" },
    { "role": "faint", "hex": "#3a4166", "use": "inactive tracks and guides" },
    { "role": "accent", "hex": "#ff7a45", "use": "the warm diagram accent (sunset light, heat); never type" },
    { "role": "accent2", "hex": "#4aa8ff", "use": "blue light: short waves, scatter sparks; never type" },
    { "role": "sun", "hex": "#ffe9a8", "use": "the sun disc and its glow, the sunlight beam's glow" },
    { "role": "beam", "hex": "#fffaf0", "use": "the white core of the sunlight beam" },
    { "role": "red", "hex": "#ff5a4e", "use": "spectrum: red light, long red waves" },
    { "role": "orange", "hex": "#ff9a3c", "use": "spectrum: orange light" },
    { "role": "yellow", "hex": "#ffd84a", "use": "spectrum: yellow light" },
    { "role": "green", "hex": "#5fd68a", "use": "spectrum: green light" },
    { "role": "blue", "hex": "#4aa8ff", "use": "spectrum: blue light (same as accent2)" },
    { "role": "violet", "hex": "#a77bff", "use": "spectrum: violet light" },
    { "role": "pale-blue", "hex": "#d9eeff", "use": "blue sparks and rays over the day sky, where plain blue would vanish" },
    { "role": "hill", "hex": "#1b4d3e", "use": "the hill along the bottom of day and sunset frames" },
    { "role": "figure", "hex": "#0d1430", "use": "the child silhouette on the hill" }
  ],
  "grounds": {
    "night": { "glow": "surface", "ellipse": [90, 60], "at": [50, 58], "fade": 75 },
    "day": [["#1c4fbf", 0], ["#3f8cf2", 45], ["#8cc4ff", 80], ["#cfe9ff", 100]],
    "sunset": [["#2a1b5e", 0], ["#7a3f8f", 38], ["#e0645a", 72], ["#ffb465", 100]]
  },
  "fonts": {
    "display": { "family": "Fredoka", "source": "google", "weights": [500, 700], "italic": false },
    "body": { "family": "Inter", "source": "google", "weights": [400, 500], "prefer": "Inter 18pt" }
  },
  "type": {
    "display": 112,
    "title": 124,
    "number": 280,
    "list": 72,
    "body": 34,
    "label": 38,
    "eyebrow": 24,
    "min": 24,
    "minDisplay": 84,
    "weight": 500,
    "emphasisWeight": 700,
    "labelWeight": 500,
    "charEm": 0.47,
    "leading": 1.1,
    "tracking": 0,
    "eyebrowTracking": 1.5,
    "case": "sentence",
    "emphasis": "weight",
    "maxWords": 6,
    "maxLines": 2
  },
  "layout": { "margin": 96, "safe": { "top": 230, "bottom": 330 }, "align": "center", "headlineY": 500, "diagramBand": [760, 1520] },
  "motion": {
    "recipes": {
      "rise": { "kind": "ease", "curve": "expo-out", "duration": 0.55, "distance": 20 },
      "eyebrow": { "kind": "ease", "curve": "expo-out", "duration": 0.5, "distance": 10 },
      "rule": { "kind": "ease", "curve": "expo-out", "duration": 0.9 },
      "pill": { "kind": "ease", "curve": "expo-out", "duration": 0.5, "distance": 12 },
      "draw": { "kind": "ease", "curve": "expo-out", "duration": 1.4 },
      "beam": { "kind": "ease", "curve": "expo-out", "duration": 0.9 },
      "fan": { "kind": "ease", "curve": "expo-out", "duration": 1.1 },
      "pop": { "kind": "ease", "curve": "expo-out", "duration": 0.5 },
      "ray": { "kind": "ease", "curve": "expo-out", "duration": 0.8 },
      "travel": { "kind": "ease", "curve": "expo-out", "duration": 0.9 },
      "spark": { "kind": "ease", "curve": "linear", "duration": 1.0 },
      "ground": { "kind": "ease", "curve": [0.3333, 0, 0.6667, 1], "duration": 1.4 },
      "count": { "kind": "ease", "curve": "expo-out", "duration": 1.4 },
      "crossfade": { "kind": "ease", "curve": [0.3333, 0, 0.6667, 1], "duration": 0.4 },
      "out": { "kind": "ease", "curve": "expo-out", "duration": 0.35 }
    },
    "enter": "rise",
    "exit": "out",
    "stagger": 0.09,
    "hold": 1.5,
    "popSpread": 1.2,
    "sparkEvery": 1.6,
    "burstEvery": 0.55
  },
  "elements": {
    "sun": { "r": 70, "glow": [[0.45, 1.25], [0.12, 2.2], [0, 4]] },
    "beam": { "core": 26, "glow": 70, "glowOpacity": 0.25 },
    "fan": { "step": 88, "half": 26, "blur": 10, "glowOpacity": 0.3 },
    "wave": {
      "glowWidth": 3.2,
      "glowOpacity": 0.22,
      "red": { "lambda": 420, "amp": 90, "width": 11, "speed": 0.45 },
      "blue": { "lambda": 110, "amp": 52, "width": 9, "speed": 1.6 },
      "rainbow": { "lambda": 260, "amp": 70, "width": 9, "speed": 0.6 },
      "hit": { "lambda": 80, "amp": 34, "width": 8, "speed": 2 }
    },
    "molecule": { "r": [7, 11], "halo": 2.2, "haloOpacity": 0.12, "opacity": 0.9, "wobble": 4 },
    "spark": { "count": 8, "from": 16, "to": 150, "reach": 1.4, "length": 26, "width": 6, "ring": [10, 40], "ringWidth": 3, "ringOpacity": 0.4 },
    "ray": { "width": 4, "dash": [4, 14], "opacity": 0.55, "dot": 9, "speed": 0.7 },
    "pill": { "padY": 12, "padX": 26, "fill": 0.66, "border": 2, "borderOpacity": 0.55, "dot": 18, "dotGlow": 12 },
    "bar": { "height": 24, "glow": 1.8, "track": 0.1 },
    "rule": { "width": 140, "opacity": 0.22 },
    "hill": { "left": 1580, "crest": 1420, "right": 1540 },
    "kid": { "x": 700, "head": 36 }
  },
  "finish": { "grain": 0.02, "vignette": 0.3, "glow": true, "halo": 0.8 },
  "banned": [
    "a second text colour, or colour on type: spectrum colours are for light and diagrams only",
    "italics (Fredoka has none): emphasis is the heavier weight in the same colour",
    "more than about 5 words per headline or more than 2 lines",
    "type over the bright sun or a busy diagram: headlines stay in the top band",
    "textures, photos, 3D renders or realistic shading: flat shapes and soft glows only",
    "jargon or formulas on screen (no equations, no 'Rayleigh')",
    "snapping, bouncing or linear moves on type; frozen frames (waves keep travelling)",
    "harsh flashes, strobing or fast cuts",
    "emoji, stock icons, mascots or brand characters"
  ],
  "sources": [
    { "what": "the user's own video \"Why the sky is blue\" (style.md \"Night-sky classroom\", plan, scene code, check frames)", "where": "D:\\code_files\\animations\\project-5-why-the-sky-is-blue", "licence": "the user's own" }
  ]
}
