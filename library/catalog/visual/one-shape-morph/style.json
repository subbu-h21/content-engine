{
  "id": "one-shape-morph",
  "name": "One-Shape Morph",
  "kind": "visual",
  "version": 1,
  "status": "built-in",
  "summary": "B-roll that never cuts: one rounded shape on a warm-grey stage morphs pill → card → chart → session bar, its content blur-swaps on spoken words, a black cursor drives every change, and one orange accent marks what matters.",
  "tags": ["calm", "light", "ui", "morph", "sans", "mono", "b-roll", "cursor"],
  "suits": ["explainer", "tutorial", "talking-head b-roll", "tool explainer", "facts"],
  "needs": { "footage": false, "3d": false },
  "frame": { "width": 1080, "height": 1920 },
  "palette": [
    { "role": "background", "hex": "#e9e7e2", "use": "the warm-grey stage behind full-frame cutaways" },
    { "role": "text", "hex": "#0b0b0b", "use": "ink: dark pills, chips and session bars, all text on light, bar fills, the cursor" },
    { "role": "surface", "hex": "#ffffff", "use": "the shape in its card, doc and comparison states" },
    { "role": "muted", "hex": "#8a8782", "use": "sub-labels, captions, mono statuses" },
    { "role": "muted2", "hex": "#9a9791", "use": "sub-lines inside black shapes" },
    { "role": "faint", "hex": "#e2dfd9", "use": "hairlines and progress tracks" },
    { "role": "skeleton", "hex": "#e6e3de", "use": "skeleton text lines, slider tracks" },
    { "role": "docLine", "hex": "#dcd8d1", "use": "lines in the document state" },
    { "role": "accent", "hex": "#ff5a1f", "use": "the one accent: the chip that fills in, the first bar, the badge, the name pulse, the chapter number" },
    { "role": "accent2", "hex": "#e14a12", "use": "the accent's darker side (a folder's tab)" },
    { "role": "panel", "hex": "#f4f2ee", "use": "the light shape of transparent panel clips over dark footage" },
    { "role": "ghost", "hex": "#bdb8b0", "use": "the 3 px dashed border of a drop target (its text #a29e97)" }
  ],
  "fonts": {
    "display": { "family": "Geist", "source": "google", "weights": [600] },
    "body": { "family": "Geist", "source": "google", "weights": [400, 600] },
    "mono": { "family": "Geist Mono", "source": "google", "weights": [400, 500] }
  },
  "type": {
    "display": 54,
    "pill": 48,
    "cardTitle": 34,
    "section": 27,
    "body": 25,
    "badge": 22,
    "mono": 25,
    "terminal": 26,
    "chapterNumber": 150,
    "chapterTitle": 60,
    "chapterSub": 28,
    "label": 22,
    "min": 24,
    "minWorld": 20,
    "leading": 1.12,
    "tracking": -0.02,
    "case": "sentence",
    "emphasis": "colour and shape: the accent chip fills in, a name pulses accent",
    "maxWords": 14,
    "note": "sizes are world px on the shape; the camera zoom (cam) makes them bigger on screen"
  },
  "layout": {
    "margin": 84,
    "safe": { "top": 230, "bottom": 330 },
    "align": "center",
    "centerY": 900,
    "cam": { "pill": 1.4, "card": 1.2 },
    "states": {
      "pill": { "w": 640, "h": 120, "r": 60 },
      "card": { "w": 760, "h": 520, "r": 36 },
      "diagram": { "w": 760, "h": 820, "r": 40 },
      "chart": { "w": 760, "h": 900, "r": 40 },
      "lanes": { "w": 760, "h": 540, "r": 36 },
      "session": { "w": 700, "h": 120, "r": 60 }
    },
    "iconStroke": 2.2,
    "cursor": 46
  },
  "motion": {
    "recipes": {
      "morph": { "kind": "spring", "damping": 25.2, "stiffness": 225, "mass": 1 },
      "fast": { "kind": "spring", "damping": 46.44, "stiffness": 729, "mass": 1 },
      "slow": { "kind": "spring", "damping": 22.5, "stiffness": 156.25, "mass": 1 },
      "soft": { "kind": "spring", "damping": 19, "stiffness": 100, "mass": 1 },
      "cam": { "kind": "spring", "damping": 15, "stiffness": 56.25, "mass": 1 },
      "colour": { "kind": "spring", "damping": 40, "stiffness": 400, "mass": 1 },
      "intro": { "kind": "spring", "damping": 20.28, "stiffness": 169, "mass": 1 },
      "press": { "kind": "spring", "damping": 90, "stiffness": 2025, "mass": 1 },
      "release": { "kind": "spring", "damping": 31.68, "stiffness": 484, "mass": 1 },
      "bars": { "kind": "spring", "damping": 21.32, "stiffness": 169, "mass": 1 },
      "badge": { "kind": "spring", "damping": 22.4, "stiffness": 256, "mass": 1 },
      "vis": { "kind": "ease", "curve": [0.33, 1, 0.68, 1], "duration": 0.26 },
      "visOut": { "kind": "ease", "curve": [0.33, 1, 0.68, 1], "duration": 0.12 },
      "skeleton": { "kind": "ease", "curve": [0.65, 0, 0.35, 1], "duration": 0.45 },
      "cursor": { "kind": "ease", "curve": [0.65, 0, 0.35, 1], "duration": 0.7 }
    },
    "enter": "vis",
    "exit": "visOut",
    "visDelay": 0.07,
    "visBlur": 12,
    "visBlurOut": 9.6,
    "visScale": 0.94,
    "rowShift": 13,
    "rowGap": 0.3,
    "laneStagger": 0.1,
    "skeletonStagger": 0.18,
    "barStagger": 0.07,
    "pressLead": 0.07,
    "releaseAfter": 0.035,
    "pressScale": 0.035,
    "cursorPressScale": 0.13,
    "cursorArc": 0.06,
    "pulseSigma": 0.16,
    "stagger": 0.3,
    "hold": 0.4
  },
  "finish": {
    "grain": 0,
    "vignette": 0,
    "glow": false,
    "shadow": "0 1px 2px rgba(20,18,14,0.06), 0 10px 30px -8px rgba(20,18,14,0.16)",
    "cursorShadow": "0 2px 3px rgba(0,0,0,0.25)",
    "motionBlur": { "subframes": 4, "shutter": 180 }
  },
  "banned": [
    "cuts inside a clip: the shape morphs and the content blur-swaps",
    "bouncy easing (springs overshoot a tiny amount at most)",
    "particles",
    "glows",
    "gradients on UI chrome",
    "mixed icon strokes",
    "dead time: every state change lands on a spoken word",
    "anything that looks like a template",
    "made-up data, numbers, quotes, prices or results",
    "a second accent colour"
  ],
  "sources": [
    { "what": "skill motion-broll: engine (motion.js, base.css), engine-api.md, examples opus-aoe2 01–06 and plan.json", "where": "github.com/Barty-Bart/motion-graphics skills/motion-broll; research notes docs/research/styles/barty-bart-and-prompt-motion.md, section One-Shape Morph B-roll", "licence": "MIT (c) 2026 Bart; Geist / Geist Mono SIL OFL 1.1; icon idea from Lucide (ISC), redrawn" }
  ]
}
