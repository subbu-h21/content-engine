    { "role": "jacket-light", "hex": "#86b6ff", "use": "jacket highlight" },
    { "role": "jacket-line", "hex": "#112459", "use": "jacket line" },
    { "role": "scarf-shade", "hex": "#cf3d5b", "use": "scarf shadow" },
    { "role": "scarf-light", "hex": "#ffb6a2", "use": "scarf highlight" },
    { "role": "scarf-line", "hex": "#761b34", "use": "scarf line" },
    { "role": "teal-shade", "hex": "#12857c", "use": "teal shadow" },
