    "dawn": { "lit": [1.04, 0.9, 0.84], "shade": [0.86, 0.66, 0.8], "line": [1, 0.8, 0.85] },
    "backlit": { "lit": [0.42, 0.3, 0.55], "shade": [0.36, 0.26, 0.5], "line": [0.4, 0.3, 0.6] }
