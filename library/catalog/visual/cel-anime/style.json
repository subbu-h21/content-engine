  "fonts": {
    "display": { "family": "Kanit", "source": "google", "weights": [800, 900], "italic": true },
    "body": { "family": "Barlow Semi Condensed", "source": "google", "weights": [600], "italic": true }
  },
  "type": {
    "display": 150,
    "title": 150,
    "number": 300,
    "body": 60,
    "label": 38,
    "tagline": 40,
    "min": 32,
    "leading": 0.98,
    "bodyLeading": 1.18,
    "tracking": -0.01,
    "taglineTracking": 0.42,
    "case": "titles in capitals; subtitles in sentence case",
    "emphasis": "italic in the subtitle colour; on titles the chrome itself",
    "outline": 9,
    "titleOutline": 14,
    "neonOutline": 26,
    "maxWords": 9
  },
  "layout": { "margin": 72, "safe": { "top": 230, "bottom": 330 }, "align": "center", "subtitleY": 1336 },
  "elements": {
    "line": 2.6,
    "shadowShift": [10, 8],
    "lightShift": [5, 4],
    "rim": 3,
    "scanline": 4,
    "scanlineStrength": 0.18,
    "chroma": 2.5,
    "chromaBlur": 1.6,
    "corner": 0.28,
    "glow": 18
  },
  "motion": {
    "recipes": {
      "flicker": { "kind": "ease", "curve": "linear", "duration": 0.42 },
      "sweep": { "kind": "ease", "curve": [0.65, 0, 0.35, 1], "duration": 1.1 },
      "sub": { "kind": "ease", "curve": "linear", "duration": 0.08 },
      "streak": { "kind": "ease", "curve": [0.33, 1, 0.68, 1], "duration": 0.5 },
      "burst": { "kind": "ease", "curve": [0.33, 1, 0.68, 1], "duration": 0.35 },
      "tilt": { "kind": "ease", "curve": [0.55, 0, 1, 0.45], "duration": 1.6 },
      "pan": { "kind": "ease", "curve": "linear", "duration": 6 }
    },
    "enter": "cut",
    "exit": "cut",
    "twos": 12,
    "threes": 8,
    "stagger": 0.083,
    "hold": 1.9,
    "bpm": 116
  },
  "finish": { "grain": 0.025, "vignette": 0, "glow": true, "scanlines": 0.18, "corner": 0.28, "chroma": 2.5 },
  "banned": [
    "moe anime: round faces, giant irises, hatched blush",
    "vector clip-art: uniform black lines, gradients inside cels",
    "film artefacts: gate weave, dust, scratches, misregistration (this is videotape, not film)",
    "pure black lines except on hard props",
    "a colour filter as a time-of-day change: each light gets its own colour model",
    "digital dissolves or wipes",
    "any existing work's characters, mecha, logos, place names or signature shots; brand names on signs",
    "front views of faces where a back view, a visor or backlight will do",
    "thick rim light on thin shapes"
  ],
