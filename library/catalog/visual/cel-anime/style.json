    { "role": "iris-top", "hex": "#150a33", "use": "the iris's top band" },
    { "role": "lash", "hex": "#1c0f26", "use": "the lash line" },
    { "role": "eye-white", "hex": "#fbf8ff", "use": "eye whites" }
