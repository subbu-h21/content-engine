{
  "id": "cel-anime",
  "name": "Cel Anime",
  "kind": "visual",
  "version": 1,
  "status": "built-in",
  "summary": "Late-80s cel animation on videotape: flat two-tone cels with coloured lines over airbrushed painted plates, neon glowing through the night, chrome italic title cards, cream-yellow outlined subtitles, limited animation on twos and a CRT finish.",
  "tags": ["anime", "retro", "80s", "neon", "night city", "cel", "crt", "cinematic"],
  "suits": ["night and city stories", "mock opening titles", "nostalgic explainers", "journeys and deadlines", "music-led shorts"],
  "needs": { "footage": false, "3d": false },
  "frame": { "width": 1080, "height": 1920 },
  "palette": [
    { "role": "background", "hex": "#0e0b2e", "use": "the top of the night plate; the darkest ground (proposed)" },
    { "role": "surface", "hex": "#24185a", "use": "the night plate's upper sky (proposed)" },
    { "role": "text", "hex": "#fff0a0", "use": "subtitles: cream-yellow with a dark outline" },
    { "role": "muted", "hex": "#8ff4ff", "use": "the second speaker's subtitles and its boxed tag (cyan)" },
    { "role": "faint", "hex": "#50546e", "use": "dark props' highlight, HUD frame lines" },
    { "role": "accent", "hex": "#ff6b6b", "use": "the scarf: the one accent colour of the cel, readable in every light; red light" },
    { "role": "accent2", "hex": "#1fc4b2", "use": "teal: the skirt, cyan-side neon" },
    { "role": "outline", "hex": "#1a1030", "use": "the subtitles' and titles' dark outline (proposed)" },
    { "role": "magenta", "hex": "#ff4fa8", "use": "neon signs, the title's neon outline, rim light" },
    { "role": "gold", "hex": "#e2b24e", "use": "lit windows, the sun's core" },
    { "role": "gold-light", "hex": "#fff0b0", "use": "window highlights, flares" },
    { "role": "chrome", "hex": "#dfe7f3", "use": "the molecule (chrome colour model)" },
    { "role": "chrome-shade", "hex": "#646f90", "use": "chrome shadow" },
    { "role": "chrome-line", "hex": "#2b3350", "use": "chrome line" },
    { "role": "dark", "hex": "#2b2d40", "use": "hard props and tights (the only near-blacks)" },
    { "role": "dark-shade", "hex": "#181a26", "use": "dark props' shadow; skyline silhouettes" },
    { "role": "dark-line", "hex": "#08090f", "use": "dark props' line" },
