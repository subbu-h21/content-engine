{
  "id": "obsidian-chrome",
  "name": "Obsidian Chrome",
  "kind": "visual",
  "version": 1,
  "status": "built-in",
  "summary": "Premium product-ad look: glossy obsidian pills and glass cards on a black field, heavy all-caps silver-gradient type, one amber rim, and one metallic glint per shot.",
  "tags": ["premium", "dark", "chrome", "silver", "product", "pills", "overlay", "sans"],
  "suits": ["product promos", "app launches", "AI-tool explainers", "stat callouts", "calls to action", "overlays on footage"],
  "needs": { "footage": false, "3d": false },
  "frame": { "width": 1080, "height": 1920 },
  "palette": [
    { "role": "background", "hex": "#0a0a0b", "use": "the black field (obsidian base); on footage the style is a transparent overlay instead" },
    { "role": "surface", "hex": "#1b1b1f", "use": "glass cards, chart cards" },
    { "role": "surface2", "hex": "#232327", "use": "list rows, the lower end of a card's gradient" },
    { "role": "obsidianTop", "hex": "#2b2b2e", "use": "pill and tile gradient start (180°)" },
    { "role": "obsidianMid", "hex": "#161618", "use": "pill gradient at 46%" },
    { "role": "text", "hex": "#f4f4f6", "use": "headline silver base: the colour behind the silver gradient, and plain silver strokes" },
    { "role": "silverTop", "hex": "#ffffff", "use": "silver gradient start (top of every glyph), glint peak" },
    { "role": "silverMid", "hex": "#dedee2", "use": "silver gradient at 44%" },
    { "role": "silverBase", "hex": "#999aa2", "use": "silver gradient end (bottom of every glyph); the dim bar in comparisons" },
    { "role": "muted", "hex": "#d6d6da", "use": "subcopy, always at 72% opacity" },
    { "role": "faint", "hex": "#3a3a40", "use": "card gridlines and inactive tracks (proposed)" },
    { "role": "accent", "hex": "#e8b768", "use": "amber: the guide line, the inner rim of the emphasis pill, the atmosphere tint; nothing else is warm" },
    { "role": "accent2", "hex": "#cfe0ff", "use": "pale glow tint: the glow of an icon tile or a light ray, never type" },
    { "role": "spark", "hex": "#fff6df", "use": "the travelling spark core (once per shot)" },
    { "role": "alert", "hex": "#ff4b4b", "use": "a notification badge only" }
  ],
  "fonts": {
    "display": { "family": "Inter", "source": "google", "weights": [800] },
    "body": { "family": "Inter", "source": "google", "weights": [400, 600] },
    "mono": { "family": "Geist Mono", "source": "google", "weights": [500] }
  },
  "type": {
    "display": 156,
    "pill": 120,
    "number": 240,
    "cta": 40,
    "row": 36,
    "body": 30,
    "label": 26,
    "micro": 24,
    "min": 24,
    "leading": 0.88,
    "tracking": -0.055,
    "pillTracking": -0.045,
    "ctaTracking": 0.18,
    "bodyTracking": 0.04,
    "microTracking": 0.2,
    "microOpacity": 0.52,
    "mutedOpacity": 0.72,
    "charEm": 0.66,
    "case": "upper",
    "emphasis": "pill",
    "maxWords": 6
  },
  "layout": { "margin": 96, "safe": { "top": 230, "bottom": 330 }, "align": "center", "guideY": 1060 },
  "motion": {
    "recipes": {
      "pillIn": { "kind": "ease", "curve": "expo-out", "duration": 0.85, "distance": 90 },
      "labelIn": { "kind": "ease", "curve": [0.25, 1, 0.5, 1], "duration": 0.6, "distance": 14 },
      "subIn": { "kind": "ease", "curve": [0.25, 1, 0.5, 1], "duration": 0.6, "distance": 18 },
      "arc": { "kind": "ease", "curve": [0.22, 1, 0.36, 1], "duration": 0.72, "distance": 112 },
      "guide": { "kind": "ease", "curve": [0.76, 0, 0.24, 1], "duration": 0.68 },
      "atmosphere": { "kind": "ease", "curve": [0.25, 1, 0.5, 1], "duration": 0.72 },
      "squash": { "kind": "ease", "curve": [0.25, 1, 0.5, 1], "duration": 0.43 },
      "settle": { "kind": "ease", "curve": [0.34, 1.5, 0.64, 1], "duration": 0.34 },
      "glint": { "kind": "ease", "curve": [0.65, 0, 0.35, 1], "duration": 0.9 },
      "spark": { "kind": "ease", "curve": [0.76, 0, 0.24, 1], "duration": 0.68 },
      "rise": { "kind": "ease", "curve": [0.22, 1, 0.36, 1], "duration": 0.8, "distance": 60 },
      "bar": { "kind": "ease", "curve": [0.22, 1, 0.36, 1], "duration": 0.7 },
      "heroBar": { "kind": "ease", "curve": [0.22, 1, 0.36, 1], "duration": 0.95 },
      "draw": { "kind": "ease", "curve": [0.76, 0, 0.24, 1], "duration": 1.0 },
      "slide": { "kind": "ease", "curve": [0.22, 1, 0.36, 1], "duration": 0.8, "distance": 80 },
      "snap": { "kind": "ease", "curve": [0.34, 1.5, 0.64, 1], "duration": 0.4 },
      "maskRise": { "kind": "ease", "curve": [0.22, 1, 0.36, 1], "duration": 1.0, "distance": 1.2 },
      "divider": { "kind": "ease", "curve": [0.83, 0, 0.17, 1], "duration": 1.0 },
      "out": { "kind": "ease", "curve": [0.32, 0, 0.67, 0], "duration": 0.45, "distance": 40 }
    },
    "enter": "pillIn",
    "exit": "out",
    "stagger": 0.09,
    "rowStagger": 0.12,
    "barDelay": 0.17,
    "hold": 1.2
  },
  "elements": {
    "pill": {
      "radius": 999,
      "padX": 0.42,
      "padY": 0.2,
      "highlight": "inset 0 2px 1px rgba(255,255,255,.22)",
      "shade": "inset 0 -3px 6px rgba(0,0,0,.85)",
      "drop": "0 30px 55px rgba(0,0,0,.55)",
      "border": 0.1,
      "cap": 0.48,
      "capOpacity": 0.3,
      "rim": 1.5,
      "rimOpacity": 0.6,
      "squash": [0.93, 1.06],
      "stretch": [1.08, 0.95],
      "ctaPadX": 1.3,
      "ctaPadY": 0.8
    },
    "glint": { "width": 0.45, "skew": -18, "peak": 0.55, "from": -0.6, "to": 1.6 },
    "contactShadow": { "opacity": 0.48, "blur": 18 },
    "guide": { "width": 960, "stroke": 1, "opacity": 0.85 },
    "card": { "radius": 46, "grid": 74, "gridOpacity": 0.5, "border": 0.1 },
    "tile": { "size": 96, "radius": 26 },
    "atmosphere": { "opacity": 0.12, "fromScale": 0.72, "blur": 22 },
    "orbit": { "opacity": 0.1, "fromScale": 0.9, "fromRotate": -9 },
    "bloom": 0.35
  },
  "finish": { "grain": 0, "vignette": 0, "glow": true, "bloom": "restrained: the hero bar and light rays only" },
  "banned": [
    "more than one glint or sheen per shot; a glint early in a shot",
    "looping bob, idle float, breathing pills or drifting type after it lands",
    "decorative glow spam: bloom only on the hero bar and on light rays",
    "generic tiles, fake UI or decorative clutter; decorative telemetry",
    "a second warm colour; amber on anything but the emphasis pill, its guide line and the atmosphere",
    "lowercase or light-weight headlines; type without the silver gradient",
    "bounce anywhere but the one restrained settle of the emphasis pill",
    "grain, noise or texture on the field",
    "distorting, redrawing or inventing a real brand mark"
  ],
  "sources": [
    { "what": "NullMotion's template catalog prompts and the preview pages' CSS/GSAP values (Chrome CTA, Kinetic Headline, App Icon Float, Slide-In Showcase, Compare Bars, Connector List, Blur Reveal)", "where": "docs/research/styles/ecc-nullmotion-3b1b-web.md, \"Obsidian Chrome (NullMotion house look)\" and \"NullMotion catalog: the 23 templates as shots\"", "licence": "MIT (third-party app marks in the previews are not used)" }
  ]
}
