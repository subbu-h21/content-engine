    { "role": "rose", "hex": "#e27a92", "use": "red light, hearts, blush" },
    { "role": "sap", "hex": "#6e9f58", "use": "grass and hills" },
    { "role": "teal", "hex": "#3a9c98", "use": "the character's body" },
    { "role": "teal-dark", "hex": "#2a7470", "use": "the character's shade (proposed)" },
    { "role": "violet", "hex": "#7b5ca8", "use": "violet light, the air molecule's shade" },
    { "role": "gold", "hex": "#f0be46", "use": "yellow light, the sun's core" },
    { "role": "glow", "hex": "#ffc766", "use": "additive light (glows)" },
