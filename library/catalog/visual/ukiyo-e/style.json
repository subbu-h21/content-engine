{
  "id": "ukiyo-e",
  "name": "Ukiyo-e Print",
  "kind": "visual",
  "version": 1,
  "status": "built-in",
  "summary": "A woodblock print come to life on a tall pillar sheet: flat colour blocks printed slightly out of register under a sumi key line, woodgrain and baren streaks in every block, wandering bokashi skies, mist bands, a double ink border, cream cartouches and a red seal.",
  "tags": ["woodblock", "print", "east asian", "flat colour", "prussian blue", "paper", "travel", "calm"],
  "suits": ["travel and journeys", "Japanese culture and poetry", "one subject in many places or seasons", "steps or stations of a process", "calm explainers about nature and the sky"],
  "needs": { "footage": false, "3d": false },
  "frame": { "width": 1080, "height": 1920 },
  "palette": [
    { "role": "background", "hex": "#eee2c6", "use": "washi: the only white (foam, snow, mist, blank sky)" },
    { "role": "text", "hex": "#231f1c", "use": "sumi: every key line and every word" },
    { "role": "muted", "hex": "#c7b893", "use": "dark paper fibres; distant grey key lines" },
    { "role": "faint", "hex": "#fbf6e9", "use": "light paper fibres" },
    { "role": "accent", "hex": "#b8412f", "use": "beni red: the sun, seals, a garment, the cartouche tab (rare)" },
    { "role": "accent2", "hex": "#1d3a66", "use": "Prussian blue: sky, water, mountain (the dominant family)" },
    { "role": "prussianDark", "hex": "#13284a", "use": "the top of a bokashi sky, deep water" },
    { "role": "prussianLight", "hex": "#4d6f98", "use": "middle blues" },
    { "role": "trough", "hex": "#0f2344", "use": "the inside of a wave" },
    { "role": "paleBlue", "hex": "#8db0c6", "use": "water reflections, lower sky" },
    { "role": "paleBlue2", "hex": "#bcd0d6", "use": "the palest sky" },
    { "role": "beniPale", "hex": "#e3a08a", "use": "dawn bokashi" },
    { "role": "peach", "hex": "#efc4a8", "use": "dawn, mist bands" },
    { "role": "ochre", "hex": "#cf9f4a", "use": "hats, roads, obi, sunlight" },
    { "role": "straw", "hex": "#c9a45c", "use": "straw, fields" },
    { "role": "green", "hex": "#8aa152", "use": "fields" },
    { "role": "greenDark", "hex": "#50703c", "use": "trees" },
    { "role": "pine", "hex": "#3e5a3a", "use": "pine needle pads" },
    { "role": "indigoCloth", "hex": "#2c4a70", "use": "clothing" },
    { "role": "gaiters", "hex": "#1d2c44", "use": "gaiters, dark cloth" },
    { "role": "mount", "hex": "#c9b690", "use": "the mounting scroll between sheets" },
    { "role": "cartouche", "hex": "#f3e7c6", "use": "cream cartouche slips" },
