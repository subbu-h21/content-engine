  "fonts": {
    "display": { "family": "Yuji Syuku", "source": "google", "weights": [400] },
    "body": { "family": "Shippori Mincho", "source": "google", "weights": [500] }
  },
  "type": {
    "display": 64,
    "title": 64,
    "number": 230,
    "body": 46,
    "label": 40,
    "tab": 30,
    "min": 30,
    "leading": 1.25,
    "tracking": 0.02,
    "case": "sentence",
    "emphasis": "the red seal stamp",
    "maxWords": 8
  },
  "layout": { "margin": 96, "safe": { "top": 230, "bottom": 330 }, "align": "left", "border": { "x": 44, "y": 40, "line": 3.4, "outer": 9 }, "textRight": 960 },
  "motion": {
    "recipes": {
      "print": { "kind": "ease", "curve": "cubic-out", "duration": 0.34 },
      "seal": { "kind": "ease", "curve": "expo-out", "duration": 0.2 },
      "cartouche": { "kind": "ease", "curve": "cubic-out", "duration": 0.3, "distance": 14 },
      "subtitle": { "kind": "ease", "curve": "cubic-out", "duration": 0.22 },
      "scroll": { "kind": "ease", "curve": "sine-in-out", "duration": 1.0 },
      "push": { "kind": "ease", "curve": "sine-in-out", "duration": 6.0 }
    },
    "enter": "printed block by block",
    "exit": "a scroll slide to the next sheet, or a cut to a blank sheet",
    "figureFps": 8,
    "rainFps": 12,
    "slide": 6,
    "hold": 1.0
  },
  "elements": {
    "registration": { "g1": [2.2, -1.3], "g2": [-1.8, 1.9], "g3": [1.5, 2.2] },
    "texture": { "wood": 0.14, "baren": 0.3, "specks": 0.3, "keySpecks": 0.12, "fibres": 0.09 },
    "keyLine": { "width": 2.7, "jitter": 0.28 },
    "bokashi": { "wander": 26 },
    "seal": { "w": 46, "h": 70 }
  },
  "finish": { "grain": 0, "vignette": 0, "glow": false },
  "banned": [
    "flat vector shapes with a paper overlay: blocks need woodgrain and misregistration",
    "bleeding washes (that's ink wash); light and shade modelled on forms",
    "perspective grids: depth by stacked layers, mist and cropping",
    "gradients other than bokashi; white pigment (the paper is the white)",
    "cross-dissolves or 3D flips",
    "reproducing a famous print or copying its composition or characters",
    "too much speckle or fibre (a sandpaper look)",
    "a stepped camera"
  ],
