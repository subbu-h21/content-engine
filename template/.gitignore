# packages come from the content engine (node_modules is a junction)
node_modules
out/
_tmp/
# heavy or regenerable: Blender frames, encoded plates, stems
renders/
public/plates/*.mp4
public/audio/*.wav
public/audio/sfx/*.wav
# derived audio (rebuilt by the pipeline); per-cue voice lines and the music source stay tracked
/audio/*.wav
__pycache__/
*.blend1
# references: study material is regenerated by `ce pipeline . refs`; large videos stay out of git
references/_study/
references/*.mp4
references/*.mov
references/*.mkv
references/*.webm
# content engine connection (machine-specific)
.mcp.json
.claude/settings.local.json